	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="¿Cuanta seguridad tienes en la respuesta que acabas de dar?<br /><br /><br /><br /><br />Pulsa un número del 1 al 7 (1 = No estoy nada segura/o; 7 = Estoy absolutamente segura/o)." x=0 y=0 z_index=0

define keyboard_response confidence_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses "1;2;3;4;5;6;7"

define sketchpad consent
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Experimento 'VILOR'<br /><br />Investigadores: Francisco Garre Frutos y Juan Lupiañez.<br /><br /><br />Este experimento forma parte de un proyecto de investigación que tiene como base<br />estudiar procesos relativos a la orientación atencional. <br /><br />El experimento consta de una única sesión con una duración aproximada de 50 minutos que<br />se realiza de forma completamente online. <br /><br />La participación en este estudio no causará más prejuicios que los derivados de la<br />exposición prolongada a la pantalla del ordenador.<br /><br />En última instancia, además de poder obtener recompensas económicas, participar<br />en este proyecto supondrá apoyar al avance del conocimiento científico.<br /><br />Si has entendido todo lo anterior y estás de acuerdo con participar: <br /><br />Pulsa la letra k" x=0 y=0 z_index=0

define keyboard_response consent_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses k

define inline_javascript counter_value_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//contador de puntos
	if (((vars.correct_keyboard_response==1) && (vars.response_time_keyboard_response<=1200)) && (vars.response_time_keyboard_response>=100)) {vars.counter_value+=vars.value}
	else {vars.counter_value-=vars.value}
	//Contador de puntos
	if (vars.counter_value>=0) {vars.counter_value=vars.counter_value}
	else {vars.counter_value=0}
	
	vars.response_time_keyboard_response=Math.round(vars.response_time_keyboard_response)
	__end__
	set _prepare ""

define inline_javascript counterbalance_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	___prepare__
	//Inicialización de variables y contadores.
	vars.random=0
	vars.duration=0
	vars.random_duration=0
	vars.correct_count=0
	vars.repeat=2
	vars.trial_count_prac=0
	vars.trial_count_rew=0
	vars.trial_count_norew=0
	vars.block_count_rew=0
	vars.block_count_norew=0
	vars.bin
	vars.p_response=0
	vars.s_response=0
	vars.awarness_first=0
	vars.awarnes_second=0
	vars.awarness_third=0
	vars.hit=0
	vars.false_alarm=0
	vars.SD1=0
	vars.SD2=0
	vars.cut_rt=0
	
	//Para los puntos.
	vars.green_value=0
	vars.red_value=0
	vars.counter_value=0
	vars.type=0
	vars.money=0
	vars.money_final=0
	
	
	//Contadores de valores. 
	vars.high_count=0
	
	
	//Contrabalanceo de color y valor.
	if (vars.subject_parity === 'odd') {
	    vars.red_value = 10
	    vars.green_value = 1
	} else {
	   vars.red_value = 1
	   vars.green_value = 10
	}
	
	
	//Contrabalanceo del color en el test de conciencia.
	if (vars.red_value==10) {vars.high_color='rojo';vars.low_color='verde'}
	else {vars.high_color='verde';vars.low_color='rojo'}
	
	//Codigo para guardar el número aleatorio que identifíca al participante
	vars.code=jatos.urlQueryParameters.code
	__end__

define sketchpad cue
	set duration 50
	set description "Muestra estímulos"
	draw line color=grey penwidth=4 show_if=always x1=0 x2=0 y1=-15 y2=15 z_index=0
	draw line color=grey penwidth=4 show_if=always x1=-15 x2=15 y1=0 y2=0 z_index=0
	draw rect color=grey fill=0 h=128 penwidth=3 show_if=always w=128 x=-316 y=-64 z_index=0
	draw rect color=white fill=0 h=128 penwidth=8 show_if="[cue]==left" w=128 x=-316 y=-64 z_index=0
	draw rect color=grey fill=0 h=-128 penwidth=3 show_if=always w=128 x=188 y=64 z_index=0
	draw rect color=white fill=0 h=128 penwidth=8 show_if="[cue]==right" w=128 x=188 y=-64 z_index=0

