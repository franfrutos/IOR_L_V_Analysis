define sequence practblock_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run practblock_loop always

define sequence practblock_sequence_1
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run practblock_loop_1 always

define loop practice_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 empty_column ""
	run practblock_sequence

