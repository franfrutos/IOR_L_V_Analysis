	set source table
	set repeat 1
	set order sequential
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 empty_column ""
	run practblock_sequence_1

define sketchpad pre_exp
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Antes de empezar, recuerda las instrucciones:<br /><br /><br />Si aparece la letra Z, pulsa la tecla z.<br />Si aparece la letra M, pulsa la tecla m.<br /><br /><br />Si te sientes preparada/o pulsa la barra espaciadora para empezar." x=0 y=0 z_index=0

