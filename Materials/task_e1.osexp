define inline_javascript trial_count_norew_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//codificar tipo de ensayo.
	if (vars.value==10){vars.type="high"}
	else {vars.type='low'}
	
	//Bins
	if (vars.trial_count_norew%16==0) {vars.bin+=1}
	else {vars.bin=vars.bin}
	
	//Qué coño está mal
	if ((vars.high_count==1) && (vars.type=='high'))
	{vars.present_vs_previus='High_High';vars.high_count=0}
	else if ((vars.high_count==1) && (vars.type=='low'))
	{vars.present_vs_previus='High_Low';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='high'))
	{vars.present_vs_previus='Low_High';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='low'))
	{vars.present_vs_previus='Low_Low';vars.high_count=0}
	
	if ((vars.trial_count_norew==1) || (vars.trial_count_norew%65==0))
	{vars.present_vs_previus= 'no'} 
	else if ((vars.trial_count_norew!=1) || (vars.trial_count_norew%65!=0)){vars.present_vs_previus=vars.present_vs_previus}
	
	//Ensayo previo
	if ((vars.present_vs_previus== "High_Low") || (vars.present_vs_previus== "High_High"))
	{vars.previus='Antes High'}
	else if ((vars.present_vs_previus== "Low_Low") || (vars.present_vs_previus== "Low_High")) {vars.previus='Antes Low'}
	else {vars.previus= 'no'}
	__end__
	___prepare__
	//Contador de ensayos. 
	vars.trial_count_norew=vars.trial_count_norew+1
	
	//Filtrar datos de prácticas.
	vars.pract='no'
	vars.reward='no'
	vars.noreward='yes'
	vars.recognition='no'
	
	//Contador de bloques.
	if ((vars.trial_count_norew%65==0) || (vars.trial_count_norew==1)){vars.block_count_norew+=1}
	else {vars.block_count_norew=vars.block_count_norew}
	
	
	
	//codificar tipo de ensayo.
	if ((vars.red_value==10) || (vars.green_value==10))
	{vars.type_rew="high"}
	else {vars.type_rew='low'}
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	__end__

define inline_javascript trial_count_prac_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	___prepare__
	//Contador de ensayos
	vars.trial_count_prac+=1
	
	//Para filtrar los datos de esta fase
	vars.pract='yes'
	vars.reward='no'
	vars.noreward='no'
	vars.recognition='no'
	//Resetear correct_count
	if (vars.trial_count_prac%21==0) {vars.correct_count=0}
	else {vars.correct_count=vars.correct_count}
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	__end__

