	setcycle 27 color green
	setcycle 27 cue left
	setcycle 27 letter M
	setcycle 27 targetpos 252
	setcycle 27 cueing Uncued
	setcycle 27 value "[green_value]"
	setcycle 28 SOA 50
	setcycle 28 color red
	setcycle 28 cue right
	setcycle 28 letter M
	setcycle 28 targetpos 252
	setcycle 28 cueing Cued
	setcycle 28 value "[red_value]"
	setcycle 29 SOA 950
	setcycle 29 color red
	setcycle 29 cue right
	setcycle 29 letter M
	setcycle 29 targetpos 252
	setcycle 29 cueing Cued
	setcycle 29 value "[red_value]"
	setcycle 30 SOA 50
	setcycle 30 color green
	setcycle 30 cue right
	setcycle 30 letter M
	setcycle 30 targetpos 252
	setcycle 30 cueing Cued
	setcycle 30 value "[green_value]"
	setcycle 31 SOA 950
	setcycle 31 color green
	setcycle 31 cue right
	setcycle 31 letter M
	setcycle 31 targetpos 252
	setcycle 31 cueing Cued
	setcycle 31 value "[green_value]"
	run recognition_trials

define loop recognition_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 empty_column ""
	run recognition_sequence

define keyboard_response recognition_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses "d;k"

define sequence recognition_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run recognition_block always

define sequence recognition_trials
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run awarness_responses_inline always
	run new_reset_feedback always
	run fixation always
	run cue always
	run SOA always
	run target_1 always
	run recognition always
	run recognition_response always
	run Response_inline always
	run logger always

define inline_javascript repeat_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	if ((vars.correct_keyboard_response==1) && (vars.response_time_keyboard_response<=1200)) {vars.correct_count+=1} else {vars.correct_count=vars.correct_count}
	
	vars.response_time_keyboard_response=Math.round(vars.response_time_keyboard_response)
	__end__
	___prepare__
	//Crear una variable que codifique el criterio de precisión (75% de aciertos)
	if ((vars.correct_count>=15) && vars.trial_count_prac%20==0)
	{vars.repeat=0}
	else if ((vars.correct_count<15) && (vars.trial_count_prac%20==0))
	{vars.repeat=1}
	else {vars.repeat=2}
	__end__

