define inline_javascript priming_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	vars.response_time_keyboard_response=Math.round(vars.response_time_keyboard_response)
	//Priming high:
	if (vars.value==10) {vars.high_count+=1}
	else (vars.high_count=0)
	__end__
	set _prepare ""

define sketchpad recognition
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="¿Cuantos puntos crees que ganarías? <br /><br /><br />Pulsa d si crees que 10.<br /><br />Pulsa k si crees que 1." x=0 y=0 z_index=0

