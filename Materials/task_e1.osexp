define loop exp_no_rew_block_loop
	set source_file ""
	set source table
	set repeat 4
	set order random
	set description "Corre otro objeto de forma repetida"
	set cycles 32
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 SOA 50
	setcycle 0 color red
	setcycle 0 cue left
	setcycle 0 letter Z
	setcycle 0 targetpos -252
	setcycle 0 cueing Cued
	setcycle 0 correct_response Z
	setcycle 0 value "[red_value]"
	setcycle 1 SOA 950
	setcycle 1 color red
	setcycle 1 cue left
	setcycle 1 letter Z
	setcycle 1 targetpos -252
	setcycle 1 cueing Cued
	setcycle 1 correct_response Z
	setcycle 1 value "[red_value]"
	setcycle 2 SOA 50
	setcycle 2 color green
	setcycle 2 cue left
	setcycle 2 letter Z
