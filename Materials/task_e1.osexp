---
API: 2.1
OpenSesame: 3.3.9
Platform: nt
---
set width 1920
set uniform_coordinates yes
set title "TFM (Fran)"
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend psycho
set round_decimals 2
set mouse_backend psycho
set keyboard_backend psycho
set height 1080
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 24
set font_italic no
set font_family mono
set font_bold no
set experiment_path "C:/Users/franf/OneDrive/Escritorio/Máster/TFM"
set disable_garbage_collection yes
set description "The main experiment item"
set coordinates uniform
set compensation 0
set color_backend psycho
set clock_backend psycho
set canvas_backend psycho
set background black

define sequence Awareness
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run awarness_first_loop always
	run blank always
	run pre_recognition always
	run pre_recognition_response always
	run Reset_inline always
	run recognition_loop always
	run blank always
	run pre_second always
	run pre_second_response always
	run blank always
	run awarness_second_loop always

define loop Awarness_first_block
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 first_question "4;5;6"
	run awarness__first_trial

define inline_javascript Cut_rt_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	vars.SD1 = vars.SD1 + ((vars.response_time_keyboard_response)*(vars.response_time_keyboard_response)/31)
	vars.SD2 = vars.SD2 + ((vars.avg_rt)*(vars.avg_rt)/31)
	vars.cut_rt2 = vars.avg_rt + Math.sqrt(vars.SD1 - vars.SD2)
	vars.cut_rt1 = vars.avg_rt - Math.sqrt(vars.SD1 - vars.SD2)
	__end__
	set _prepare ""

define sketchpad End
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Ahora sí, ¡has terminado el experimento!<br /><br />¡Muchas gracias por participar!<br /><br />Recuerda apuntar tu código de participante: [code]<br /><br /><br />Pulsa la barra espaciadora para salir del experimento." x=0 y=0 z_index=0

define keyboard_response End_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

define inline_javascript Hits_and_false_alarms
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	set _prepare ""

define sketchpad Instructions
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Tu tarea a lo largo del experimento consistirá en distinguir entre dos letras <br />que podrán aparecer a la izquierda o a la derecha <br />de una cruz que hará las veces de punto de fijación.  <br /> <br /> Mientras mantienes la vista en el punto de fijación, deberás indicar qué letra<br /> aparece en pantalla pulsando la tecla z o m de tu ordenador:<br /> <br /> Si aparece la letra Z, pulsa la tecla z.<br /> Si aparece la letra M, pulsa la tecla m.<br /><br />Asegurate de ignorar todo aquello que no este relacionado<br />con la forma de las letras, como el color en el <br />que se presentan o cualquier otro estímulo.<br /> <br /> Antes de empezar, vamos a realizar unos ensayos de práctica.<br /> <br /> Si lo has entendido todo, pulsa la barra espaciadora para comenzar. " x=0 y=0 z_index=0

define feedback Prac_response_feedback
	set reset_variables yes
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if="[correct_keyboard_response]==1" text="¡Correcto!" x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if="[correct_keyboard_response]==0" text=Incorrecto x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=40 html=yes show_if="[response_time_keyboard_response]<[cut_rt1]" text="Demasiado rápido" x=0 y=100 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=40 html=yes show_if="[response_time_keyboard_response]>[cut_rt2]" text="Demasiado lento" x=0 y=100 z_index=0

