define loop exp_rew_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 empty_column ""
	run exp_rew_sequence

define sequence exp_rew_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run exp_rew_block_loop always

define sequence exp_rew_trial_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run reset_reward_feedback always
	run trial_count_rew_inline always
	run fixation always
	run cue always
	run SOA always
	run target always
	run targetresp always
	run keyboard_response always
	run gains_feedback "[correct_keyboard_response]==1 and [response_time_keyboard_response]<=1200"
	run losses_feedback "[correct_keyboard_response]==0 or [response_time_keyboard_response]>1200 or [response_time_keyboard_response]<100 "
	run counter_value_inline always
	run Rest_rew "[trial_count_rew]%64==0 and [trial_count_rew]!=512"
	run Rest_rew_response "[trial_count_rew]%64==0 and [trial_count_rew]!=512"
	run money_inline always
	run exit "[trial_count_rew]==512"
	run exit_response "[trial_count_rew]==512"
	run logger always

define sequence experiment
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run counterbalance_inline always
	run consent always
	run consent_response always
	run before_start always
	run before_start_response always
	run welcome always
	run Instructions always
	run instructions_response always
	run practice_loop_1 always
	run practice_loop always
	run Reset_inline always
	run blank always
	run post_pract always
	run post_pract_response always
	run pre_exp always
	run pre_exp_response always
	run exp_rew_loop always
	run Reset_inline always
	run blank always
	run Pre_no_rew_exp always
	run pre_no_rew_response always
	run exp_no_rew_loop always
	run Reset_inline always
	run blank always
	run pre_questions always
	run pre_questions_response always
	run Awareness always
	run blank always
	run End always
	run End_response always

define sketchpad first_question
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="¿Crees saber de qué dependía la cantidad de puntos que ganabas?<br /><br /><br />Pulsa un número del 1 al 6 (1 = No lo sé en absoluto; 6 = Lo sé con total seguridad)." x=0 y=0 z_index=0

define keyboard_response first_question_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set correct_response "4;5;6"
	set allowed_responses "1;2;3;4;5;6"

define sketchpad fixation
	set duration "[random_duration]"
	set description "Muestra estímulos"
	draw line color=grey penwidth=4 show_if=always x1=0 x2=0 y1=-15 y2=15 z_index=0
	draw line color=grey penwidth=4 show_if=always x1=-15 x2=15 y1=0 y2=0 z_index=0
	draw rect color=grey fill=0 h=128 penwidth=3 show_if=always w=128 x=-316 y=-64 z_index=0
	draw rect color=grey fill=0 h=-128 penwidth=3 show_if=always w=128 x=188 y=64 z_index=0

define sketchpad fixation_1
	set duration "[random_duration]"
	set description "Muestra estímulos"
	draw line color=grey penwidth=4 show_if=always x1=0 x2=0 y1=-15 y2=15 z_index=0
	draw line color=grey penwidth=4 show_if=always x1=-15 x2=15 y1=0 y2=0 z_index=0
	draw rect color=grey fill=0 h=128 penwidth=3 show_if=always w=128 x=-316 y=-64 z_index=0
	draw rect color=grey fill=0 h=-128 penwidth=3 show_if=always w=128 x=188 y=64 z_index=0

define feedback gains_feedback
	set reset_variables no
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if=always text="+ [value]" x=0 y=0 z_index=0

define keyboard_response instructions_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

define sketchpad inter_trial
	set duration 750
	set description "Muestra estímulos"
	draw line color=grey penwidth=4 show_if=always x1=0 x2=0 y1=-15 y2=15 z_index=0
	draw line color=grey penwidth=4 show_if=always x1=-15 x2=15 y1=0 y2=0 z_index=0
	draw rect color=grey fill=0 h=128 penwidth=3 show_if=always w=128 x=-316 y=-64 z_index=0
	draw rect color=grey fill=0 h=-128 penwidth=3 show_if=always w=128 x=188 y=64 z_index=0

define keyboard_response keyboard_response
	set timeout 1900
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set correct_response "[correct_response]"
	set allowed_responses "z;m"

define keyboard_response keyboard_response_1
	set timeout 1900
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set correct_response "[correct_response]"
	set allowed_responses "z;m"

