define inline_javascript Response_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	if ((vars.type=='high') && (vars.response_recognition_response=='d')){vars.correct_recognition_response=1}
	else if ((vars.type=='low') && (vars.response_recognition_response=='k')){vars.correct_recognition_response=1}
	else {vars.correct_recognition_response=0}
	__end__
	set _prepare ""

