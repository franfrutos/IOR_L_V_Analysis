	setcycle 4 color red
	setcycle 4 cue right
	setcycle 4 letter Z
	setcycle 4 targetpos -252
	setcycle 4 cueing Uncued
	setcycle 4 correct_response Z
	setcycle 4 value "[red_value]"
	setcycle 5 SOA 950
	setcycle 5 color red
	setcycle 5 cue right
