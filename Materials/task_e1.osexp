define feedback losses_feedback
	set reset_variables yes
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if=always text="- [value]" x=0 y=0 z_index=0

define inline_javascript money_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//Transformación puntos-dinero.
	vars.money=vars.counter_value/281.6
	
	if ((vars.money>0) && (vars.money<=0.5)) {vars.money_final=0.5}
	else if ((vars.money>0.5) && (vars.money<=1)) {vars.money_final=1}
	else if ((vars.money>1) && (vars.money<=1.5)) {vars.money_final=1.5}
	else if ((vars.money>1.5) && (vars.money<=2)) {vars.money_final=2}
	else if ((vars.money>2) && (vars.money<=2.5)) {vars.money_final=2.5}
	else if ((vars.money>2.5) && (vars.money<=3)) {vars.money_final=3}
	else if ((vars.money>3) && (vars.money<=3.5)) {vars.money_final=3.5}
	else if ((vars.money>3.5) && (vars.money<=4)) {vars.money_final=4}
	else if ((vars.money>4) && (vars.money<=4.5)) {vars.money_final=4.5}
	else if ((vars.money>4.5) && (vars.money<=5)) {vars.money_final=5}
	else if ((vars.money>5) && (vars.money<=5.5)) {vars.money_final=5.5}
	else if ((vars.money>5.5) && (vars.money<=6)) {vars.money_final=6}
	else if ((vars.money>6) && (vars.money<=6.5)) {vars.money_final=6.5}
	else if ((vars.money>6.5) && (vars.money<=7)) {vars.money_final=7}
	else if ((vars.money>7) && (vars.money<=7.5)) {vars.money_final=7.5}
	else if ((vars.money>7.5) && (vars.money<=8)) {vars.money_final=8}
	else if ((vars.money>8) && (vars.money<=8.5)) {vars.money_final=8.5}
	else if ((vars.money>8.5) && (vars.money<=9)) {vars.money_final=9}
	else if ((vars.money>9) && (vars.money<=9.5)) {vars.money_final=9.5}
	else if ((vars.money>9.5) && (vars.money<=11)) {vars.money_final=10}
	else {vars.money_final=0}
	
	
	//Priming:
	if (vars.type=='high') {vars.high_count+=1}
	else (vars.high_count=vars.high_count)
	__end__
	set _prepare ""

define reset_feedback new_reset_feedback
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define reset_feedback new_reset_feedback_1
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

