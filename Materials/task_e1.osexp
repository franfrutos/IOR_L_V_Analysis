	set reset_variables yes
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if=always text="+ [value]" x=0 y=0 z_index=0

define sketchpad post_pract
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="¡Lo estás haciendo muy bien!<br /><br />Ahora comienza el experimento de verdad. Te toca volver a realizar exactamente<br />la misma tarea, pero ahora en función de lo bien que lo hagas podrás ganar dinero.<br /><br />A lo largo del experimento tendrás la posibilidad de ganar o perder más o menos <br />puntos según el estímulo que aparezca en pantalla, si aciertas o fallas, y la <br />velocidad con la que respondas. Algunos estímulos te harán ganar muchos puntos, <br />pero si fallas perderás la misma cantidad. Por el contrario, otros te permitirán <br />obtener muy pocos puntos, pero también te harán perder la misma cantidad. <br />Por tanto, si quieres maximizar la ganancia de puntos es recomendable que <br />respondas de la forma más rápida y precisa que puedas.<br /><br />Dichos puntos serán transformados en dinero real, pudiendo ganar <br />hasta un máximo de 10€.<br /><br />Cuando quieras empezar pulsa la barra espaciadora." x=0 y=0 z_index=0

define keyboard_response post_pract_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

define sketchpad post_target
	set duration 1000
	set description "Muestra estímulos"
	draw line color=grey penwidth=4 show_if=always x1=0 x2=0 y1=-15 y2=15 z_index=0
	draw line color=grey penwidth=4 show_if=always x1=-15 x2=15 y1=0 y2=0 z_index=0
	draw rect color=grey fill=0 h=128 penwidth=3 show_if=always w=128 x=-316 y=-64 z_index=0
	draw rect color=grey fill=0 h=-128 penwidth=3 show_if=always w=128 x=188 y=64 z_index=0

