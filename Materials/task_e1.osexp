define sequence awarness__first_trial
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run new_reset_feedback_1 always
	run first_question always
	run first_question_response always
	run logger always

define loop awarness_first_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Corre otro objeto de forma repetida"
	set cycles 1
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 empty_column ""
	run awarness_first_sequence

define sequence awarness_first_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run Awarness_first_block always

define inline_javascript awarness_responses_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	___prepare__
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	
	//codificar tipo de ensayo.
	if (vars.value==10){vars.type="high"}
	else {vars.type='low'}
	
	//Recognition
	vars.recognition='yes'
	vars.pract='no'
	vars.reward='no'
	vars.noreward='yes'
	__end__

