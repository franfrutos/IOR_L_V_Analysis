define inline_javascript Cut_RT_in
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	vars.response_time_keyboard_response=Math.round(vars.response_time_keyboard_response)
	
	vars.RT=vars.response_time_keyboard_response
	vars.sum_RT+=vars.RT
	vars.mean_RT=(vars.sum_RT/64)
	
	vars.arrayRT.push(vars.RT)
	if (vars.trial_count==64){
	let i;
	for(i = 0; i < 64;i++){
	  vars.arrayRT[i] = Math.pow((vars.arrayRT[i]-vars.mean_RT),2);
	  vars.sumsqr += vars.arrayRT[i]
	};
	vars.cut_rt_above = vars.mean_RT + Math.sqrt(vars.sumsqr/64)}
	__end__
	set _prepare ""

