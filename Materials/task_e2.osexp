define feedback losses_feedback
	set reset_variables yes
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if=always text="- [value]" x=0 y=0 z_index=0

define inline_javascript money_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//Transformación puntos-dinero.
	//Redondear a 2 decimales
	function round(value, exp) {
	  if (typeof exp === 'undefined' || +exp === 0)
	    return Math.round(value);
	
	  value = +value;
	  exp = +exp;
	
	  if (isNaN(value) || !(typeof exp === 'number' && exp % 1 === 0))
	    return NaN;
	
	  // Shift
	  value = value.toString().split('e');
	  value = Math.round(+(value[0] + 'e' + (value[1] ? (+value[1] + exp) : exp)));
	
	  // Shift back
	  value = value.toString().split('e');
	  return +(value[0] + 'e' + (value[1] ? (+value[1] - exp) : -exp));
	}
	//Dinero
	vars.money=round(vars.counter_value/246.4, 2)
	
	if ((vars.money>0) && (vars.money<=0.5)) {vars.money_final=0.5}
	else if ((vars.money>0.5) && (vars.money<=1)) {vars.money_final=1}
	else if ((vars.money>1) && (vars.money<=1.5)) {vars.money_final=1.5}
	else if ((vars.money>1.5) && (vars.money<=2)) {vars.money_final=2}
	else if ((vars.money>2) && (vars.money<=2.5)) {vars.money_final=2.5}
	else if ((vars.money>2.5) && (vars.money<=3)) {vars.money_final=3}
	else if ((vars.money>3) && (vars.money<=3.5)) {vars.money_final=3.5}
	else if ((vars.money>3.5) && (vars.money<=4)) {vars.money_final=4}
	else if ((vars.money>4) && (vars.money<=4.5)) {vars.money_final=4.5}
	else if ((vars.money>4.5) && (vars.money<=5)) {vars.money_final=5}
	else if ((vars.money>5) && (vars.money<=5.5)) {vars.money_final=5.5}
	else if ((vars.money>5.5) && (vars.money<=6)) {vars.money_final=6}
	else if ((vars.money>6) && (vars.money<=6.5)) {vars.money_final=6.5}
	else if ((vars.money>6.5) && (vars.money<=7)) {vars.money_final=7}
	else if ((vars.money>7) && (vars.money<=7.5)) {vars.money_final=7.5}
	else if ((vars.money>7.5) && (vars.money<=8)) {vars.money_final=8}
	else if ((vars.money>8) && (vars.money<=8.5)) {vars.money_final=8.5}
	else if ((vars.money>8.5) && (vars.money<=9)) {vars.money_final=9}
	else if ((vars.money>9) && (vars.money<=9.5)) {vars.money_final=9.5}
	else if ((vars.money>9.5) && (vars.money<=11)) {vars.money_final=10}
	else {vars.money_final=0}
	
	
	//Priming:
	if (vars.type=='high') {vars.high_count+=1}
	else {vars.high_count=vars.high_count}
	__end__
	set _prepare ""

define reset_feedback new_reset_feedback
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define reset_feedback new_reset_feedback_1
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define reset_feedback new_reset_feedback_2
	set description "Resets the feedback variables, such as 'avg_rt' and 'acc'"

define sketchpad post_cut
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="¡Lo estás haciendo muy bien!<br /><br />Ahora comienza el experimento de verdad. Te toca volver a realizar exactamente<br />la misma tarea, pero ahora en función de lo bien que lo hagas podrás ganar dinero.<br /><br />A lo largo del experimento tendrás la posibilidad de ganar o perder más o menos <br />puntos según el estímulo que aparezca en pantalla, si aciertas o fallas, y la <br />velocidad con la que respondas. Algunos estímulos te harán ganar muchos puntos, <br />pero si fallas o respondes demasiado lento perderás la misma cantidad. Por el <br />contrario, otros te permitirán obtener muy pocos puntos, pero también te harán <br />perder la misma cantidad. Por tanto, si quieres maximizar la ganancia de puntos <br />es recomendable que respondas de la forma más rápida y precisa que puedas.<br /><br />Dichos puntos serán transformados en dinero real, pudiendo ganar <br />hasta un máximo de 10€.<br /><br />Cuando quieras empezar pulsa la barra espaciadora." x=0 y=0 z_index=0

define keyboard_response post_cut_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

