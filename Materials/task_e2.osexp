define inline_javascript trial_count
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	___prepare__
	//Contador de ensayos
	vars.trial_count_prac2+=1
	vars.trial_count+=1
	vars.block_count=1
	
	//Para filtrar los datos de esta fase
	vars.pract='yes'
	vars.reward='no'
	vars.noreward='no'
	vars.recognition='no'
	vars.cut_rt='yes'
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	__end__

define inline_javascript trial_count_norew_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//codificar tipo de ensayo.
	if (vars.value==10){vars.type="high"}
	else {vars.type='low'}
	
	
	//Qué coño está mal
	if ((vars.high_count==1) && (vars.type=='high'))
	{vars.present_vs_previus='High_High';vars.high_count=0}
	else if ((vars.high_count==1) && (vars.type=='low'))
	{vars.present_vs_previus='High_Low';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='high'))
	{vars.present_vs_previus='Low_High';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='low'))
	{vars.present_vs_previus='Low_Low';vars.high_count=0}
	
	if ((vars.trial_count_norew==1) || (vars.trial_count_norew%65==0))
	{vars.present_vs_previus= 'no'} 
	else if ((vars.trial_count_norew!=1) || (vars.trial_count_norew%65!=0)){vars.present_vs_previus=vars.present_vs_previus}
	
	//Ensayo previo
	if ((vars.present_vs_previus== "High_Low") || (vars.present_vs_previus== "High_High"))
	{vars.previus='Antes High'}
	else if ((vars.present_vs_previus== "Low_Low") || (vars.present_vs_previus== "Low_High")) {vars.previus='Antes Low'}
	else {vars.previus= 'no'}
	__end__
	___prepare__
	//Contador de ensayos. 
	vars.trial_count_norew=vars.trial_count_norew+1
	vars.trial_count+=1
	
	//Filtrar datos de prácticas.
	vars.pract='no'
	vars.reward='no'
	vars.noreward='yes'
	vars.recognition='no'
	
	//Contador de bloques.
	if ((vars.trial_count_norew%65==0) || (vars.trial_count_norew==1)){vars.block_count=vars.block_count+1}
	else {vars.block_count=vars.block_count}
	
	//codificar tipo de ensayo.
	if ((vars.red_value==10) || (vars.green_value==10))
	{vars.type_rew="high"}
	else {vars.type_rew='low'}
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	__end__

define inline_javascript trial_count_prac_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	___prepare__
	//Contador de ensayos
	vars.trial_count_prac+=1
	vars.trial_count+=1
	
	//Para filtrar los datos de esta fase
	vars.pract='yes'
	vars.reward='no'
	vars.noreward='no'
	vars.recognition='no'
	vars.cut_rt='no'
	//Resetear correct_count
	if (vars.trial_count_prac%21==0) {vars.correct_count=0}
	else {vars.correct_count=vars.correct_count}
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250.00))
	__end__

define inline_javascript trial_count_rew_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	//codificar tipo de ensayo.
	if (vars.value==10){vars.type="high"}
	else {vars.type='low'}
	
	//Qué coño está mal
	if ((vars.high_count==1) && (vars.type=='high'))
	{vars.present_vs_previus='High_High';vars.high_count=0}
	else if ((vars.high_count==1) && (vars.type=='low'))
	{vars.present_vs_previus='High_Low';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='high'))
	{vars.present_vs_previus='Low_High';vars.high_count=0}
	else if ((vars.high_count==0) && (vars.type=='low'))
	{vars.present_vs_previus='Low_Low';vars.high_count=0}
	
	if ((vars.trial_count_rew==1) || (vars.trial_count_rew%65==0))
	{vars.present_vs_previus= 'no'} 
	else {vars.present_vs_previus=vars.present_vs_previus}
	
	//Ensayo previo
	if ((vars.present_vs_previus== "High_Low") || (vars.present_vs_previus== "High_High"))
	{vars.previus='Antes High'}
	else if ((vars.present_vs_previus== "Low_Low") || (vars.present_vs_previus== "Low_High")) {vars.previus='Antes Low'}
	else {vars.previus= 'no'}
	__end__
	___prepare__
	//Contador de ensayos. 
	vars.trial_count_rew=vars.trial_count_rew+1
	vars.trial_count+=1
	
	//Filtrar datos de prácticas.
	vars.pract='no'
	vars.reward='yes'
	vars.noreward='no'
	vars.recognition='no'
	vars.cut_rt='no'
	
	//Contador de bloques.
	if ((vars.trial_count_rew%65==0) || (vars.trial_count_rew==1)){vars.block_count+=1}
	else {vars.block_count=vars.block_count}
	
	//Jitter en fixation.
	//Creo un valor aleatorio que condiciona la positividad o negatividad de otra variable aleatoria.
	vars.random=Math.random()
	
	//Variable aleatoria que puede ser positiva o negativa.
	if (vars.random>=0.5) {vars.jitter=Math.random()}
	else {vars.jitter=(-Math.random())}
	
	//1000ms+-250: Puede aparecer entre esos valores. 
	vars.random_duration= Math.round(1000 + (vars.jitter*250)) 
	__end__

define sequence trial_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run reset_feedback always
	run trial_count_prac_inline always
	run fixation always
	run cue always
	run SOA always
	run target always
	run targetresp always
	run keyboard_response always
	run repeat_inline always
	run Prac_response_feedback always
	run RT_feedback "[response_time_keyboard_response]>1200 or [response_time_keyboard_response]<200"
	run Repeat "[repeat]==1"
	run Repeat_response "[repeat]==1"
	run logger always

define sketchpad welcome
	set start_response_interval no
	set reset_variables no
	set duration keypress
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=serif font_italic=no font_size=32 html=yes show_if=always text="¡Bienvenido/a al experimento!" x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=no font_family=serif font_italic=no font_size=32 html=yes show_if=always text="[Pulse cualquier tecla para continuar]" x=0 y=160 z_index=0

