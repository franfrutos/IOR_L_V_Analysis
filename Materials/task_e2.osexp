define keyboard_response recognition_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses "d;k"

define sequence recognition_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run recognition_block always

define sequence recognition_trials
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run awarness_responses_inline always
	run new_reset_feedback always
	run fixation always
	run cue always
	run SOA always
	run target_1 always
	run recognition always
	run recognition_response always
	run Response_inline always
	run logger always

define inline_javascript repeat_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	___run__
	if ((vars.correct_keyboard_response==1) && (vars.response_time_keyboard_response<=1200)) {vars.correct_count+=1} else {vars.correct_count=vars.correct_count}
	
	if ((vars.correct_count>=15) && (vars.trial_count_prac%20==0))
	{vars.repeat=0}
	else if ((vars.correct_count<15) && (vars.trial_count_prac%20==0))
	{vars.repeat=1}
	else {vars.repeat=2}
	
	vars.response_time_keyboard_response=Math.round(vars.response_time_keyboard_response)
	__end__
	set _prepare ""

