	vars.dif21=Math.pow((vars.RT21-vars.mean_RT),2);
	vars.dif22=Math.pow((vars.RT22-vars.mean_RT),2);
	vars.dif23=Math.pow((vars.RT23-vars.mean_RT),2);
	vars.dif24=Math.pow((vars.RT24-vars.mean_RT),2);
	vars.dif25=Math.pow((vars.RT25-vars.mean_RT),2);
	vars.dif26=Math.pow((vars.RT26-vars.mean_RT),2);
	vars.dif27=Math.pow((vars.RT27-vars.mean_RT),2);
	vars.dif28=Math.pow((vars.RT28-vars.mean_RT),2);
