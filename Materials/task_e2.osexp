define sketchpad before_start
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Antes de comenzar, es necesario que te concentres y evites cualquier tipo de distracción,<br />dado que es importante controlar el ruido que puede producir el contexto en el que <br />cada persona realiza la tarea. Además, recuerda que en función de tu desempeño podrás <br />ganar dinero real. Cualquier tipo de distracción te afectará negativamente.<br />  <br />Por tanto, te pedimos que realices el experimento en un lugar con buena conexión <br />a internet, lo más aislado posible, e iluminación tenue. Además, por favor,  apague, <br />bloquee o mantenga fuera de su alcance el teléfono móvil durante la realización del <br />experimento.<br /><br /> <br />Si has seguido las indicaciones, pulsa la barra espaciadora." x=0 y=0 z_index=0

define keyboard_response before_start_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

define sketchpad blank
	set duration 500
	set description "Muestra estímulos"

define sketchpad confidence
