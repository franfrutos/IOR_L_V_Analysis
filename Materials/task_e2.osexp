	if (vars.trial_count_prac2==64){vars.sum_squares1=(vars.dif1+vars.dif2+vars.dif3+vars.dif4+vars.dif5+vars.dif6+vars.dif7+vars.dif8+vars.dif9+vars.dif10)/63;
	vars.sum_squares2=(vars.dif11+vars.dif12+vars.dif13+vars.dif14+vars.dif15+vars.dif16+vars.dif17+vars.dif18+vars.dif19+vars.dif20)/63;
	vars.sum_squares3=(vars.dif21+vars.dif22+vars.dif23+vars.dif24+vars.dif25+vars.dif26+vars.dif27+vars.dif28+vars.dif29+vars.dif30)/63;
	vars.sum_squares4=(vars.dif31+vars.dif32+vars.dif33+vars.dif34+vars.dif35+vars.dif36+vars.dif37+vars.dif38+vars.dif39+vars.dif40)/63;
	vars.sum_squares5=(vars.dif41+vars.dif42+vars.dif43+vars.dif44+vars.dif45+vars.dif46+vars.dif47+vars.dif48+vars.dif49+vars.dif50)/63;
