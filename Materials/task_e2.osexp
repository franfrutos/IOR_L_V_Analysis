	set _prepare ""

define sequence Cut_RT_sequence
	set flush_keyboard yes
	set description "Corre un número de objetos en secuencia"
	run trial_count always
	run fixation always
	run cue always
	run SOA always
	run target always
	run targetresp always
	run keyboard_response always
	run Prac_response_feedback always
	run RT_feedback "[response_time_keyboard_response]>1200 or [response_time_keyboard_response]<200"
	run Cut_RT_inline always
	run logger always

define inline_javascript Cut_inline
	set description "Executes JavaScript code (ECMA 5.1)"
	set _run ""
	set _prepare ""

define sketchpad End
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Ahora sí, ¡has terminado el experimento!<br /><br />¡Muchas gracias por participar!<br /><br />Recuerda apuntar tu código de participante: [code]<br /><br /><br />Pulsa la barra espaciadora para salir del experimento." x=0 y=0 z_index=0

define keyboard_response End_response
	set timeout infinite
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Recoge respuestas de teclado"
	set allowed_responses space

define sketchpad Instructions
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Tu tarea a lo largo del experimento consistirá en distinguir entre dos letras <br />que podrán aparecer a la izquierda o a la derecha <br />de una cruz que hará las veces de punto de fijación.  <br /> <br /> Mientras mantienes la vista en el punto de fijación, deberás indicar qué letra<br /> aparece en pantalla pulsando la tecla z o m de tu ordenador:<br /> <br /> Si aparece la letra Z, pulsa la tecla z.<br /> Si aparece la letra M, pulsa la tecla m.<br /><br />Asegurate de ignorar todo aquello que no este relacionado<br />con la forma de las letras, como el color en el <br />que se presentan o cualquier otro estímulo.<br /> <br /> Antes de empezar, vamos a realizar unos ensayos de práctica.<br /> <br /> Si lo has entendido todo, pulsa la barra espaciadora para comenzar. " x=0 y=0 z_index=0

define feedback Prac_response_feedback
	set reset_variables yes
	set duration 750
	set description "Proporciona feedback al participante"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if="[correct_keyboard_response]==1" text="¡Correcto!" x=0 y=0 z_index=0
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=50 html=yes show_if="[correct_keyboard_response]==0" text=Incorrecto x=0 y=0 z_index=0

define sketchpad Pre_Cut
	set duration 0
	set description "Muestra estímulos"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=always text="Ya has terminado la fase de práctica.<br /><br />Ahora vamos a realizar un bloque de ensayos muy similar a lo que te encontrarás durante <br />el experimento, para poder comprobar cual es tu desempeño general antes de comenzar. <br /><br />Trata de responder de la forma más rápida y precisa que te sea posible.<br /><br />Antes de empezar, recuerda las instrucciones:<br /><br /><br />Si aparece la letra Z, pulsa la tecla z.<br />Si aparece la letra M, pulsa la tecla m.<br /><br /><br />Cuando quieras empezar, pulsa la barra espaciadora. " x=0 y=0 z_index=0

